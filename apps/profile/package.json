{
  "name": "@ns-studio/profile-app",
  "version": "1.0.0",
  "private": true,
  "description": "Micro front-end Profile. Application Angular indépendante, servie par la shell sous /remotes/profile/.",
  "scripts": {
    "start": "ng serve --port 4201 --proxy-config proxy.conf.json",
    "build": "ng build --base-href /remotes/profile/",
    "watch": "ng build --watch --configuration development --base-href /remotes/profile/"
  },
  "dependencies": {
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@ns-studio/profile-contract": "*",
    "@ns-studio/profile-ui": "*",
    "@ns-studio/ui": "*",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.4"
  }
}
