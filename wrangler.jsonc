{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Ce nom est le premier segment de l'adresse publique : « ns » donne
  // ns.latech.workers.dev — « latech » étant le sous-domaine du compte Cloudflare,
  // réglé sur le dashboard et non ici. Le dépôt porte le même nom, pour qu'un visiteur
  // passant de GitHub au site ne se demande pas s'il est au bon endroit.
  // Le modifier crée un nouveau Worker : l'ancien reste en ligne jusqu'à suppression.
  "name": "ns",

  // Le point d'entrée est du TypeScript : wrangler le compile lui-même, au déploiement comme
  // en développement. C'est pourquoi `apps/api` n'a ni `tsc`, ni `dist/`.
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-09-10",

  "assets": {
    // Sortie de `ng build` — le projet Angular s'appelle « web », d'où `dist/web/browser`.
    "directory": "./apps/web/dist/web/browser",

    // Toute route inconnue rend `index.html` : c'est le routeur Angular qui décide ensuite.
    // Sans cela, recharger la page sur /profile renverrait un 404.
    "not_found_handling": "single-page-application",

    "binding": "ASSETS",

    // L'aiguillage de toute l'architecture. Sans cette ligne, `/api/profile` serait avalé par le
    // repli SPA ci-dessus et renverrait du HTML au lieu du JSON.
    "run_worker_first": ["/api/*"],
  },

  "observability": {
    "enabled": true,
  },
}
